GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Auth.js (next-auth v5) — generate AUTH_SECRET with: npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: set explicitly on Vercel if host auto-detection fails
# AUTH_URL=https://your-production-domain.vercel.app

# Recall.ai Meeting Bot (us-east-1)
# Workspace: HM Daniyal (f8d5b6da-b98e-456f-9df9-e07d8188196c)
RECALL_REGION=us-east-1
RECALL_API_KEY=
RECALL_WEBHOOK_VERIFICATION_SECRET=
RECALL_BOT_NAME=Brief Notetaker
# Stable public HTTPS origin for webhooks + Calendar V2 OAuth callback (no localhost)
PUBLIC_API_BASE_URL=https://fathom-ai-clone-blond.vercel.app
# Set during Calendar V2 setup from regional_callback_uri
RECALL_CALENDAR_REGIONAL_CALLBACK_URI=https://us-east-1.recall.ai/api/internal/calendar-integration/setup/oauth-callback/
